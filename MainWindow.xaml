<?xml version="1.0" encoding="utf-8"?>
<Window
    x:Class="ModoWindows.MainWindow"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    Title="Modo Windows">

    <!-- Sin Background: la ventana es transparente y solo se ve el círculo -->
    <Grid
        x:Name="RootGrid"
        PointerEntered="RootGrid_PointerEntered"
        PointerExited="RootGrid_PointerExited">
        <!-- Fundido suave al cambiar entre semitransparente y opaco -->
        <Grid.OpacityTransition>
            <ScalarTransition Duration="0:0:0.2" />
        </Grid.OpacityTransition>

        <Grid.Resources>
            <Storyboard x:Name="IconSwapAnimation">
                <DoubleAnimation
                    Storyboard.TargetName="IconRotation"
                    Storyboard.TargetProperty="Angle"
                    From="-90" To="0" Duration="0:0:0.35">
                    <DoubleAnimation.EasingFunction>
                        <CubicEase EasingMode="EaseOut" />
                    </DoubleAnimation.EasingFunction>
                </DoubleAnimation>
                <DoubleAnimation
                    Storyboard.TargetName="ThemeIcon"
                    Storyboard.TargetProperty="Opacity"
                    From="0" To="1" Duration="0:0:0.25" />
            </Storyboard>
        </Grid.Resources>

        <!--
            Colores opacos a propósito: un borde semitransparente sobre un fondo blanco
            crea un halo claro alrededor del círculo y el contorno se ve "partido".
        -->
        <Button
            x:Name="ToggleButton"
            HorizontalAlignment="Stretch"
            VerticalAlignment="Stretch"
            Padding="0"
            CornerRadius="20"
            BorderThickness="1"
            IsTabStop="False"
            UseSystemFocusVisuals="False"
            Click="ToggleButton_Click">
            <Button.Resources>
                <ResourceDictionary>
                    <ResourceDictionary.ThemeDictionaries>
                        <ResourceDictionary x:Key="Light">
                            <SolidColorBrush x:Key="ButtonBackground" Color="#FBFBFB" />
                            <SolidColorBrush x:Key="ButtonBackgroundPointerOver" Color="#F0F0F0" />
                            <SolidColorBrush x:Key="ButtonBackgroundPressed" Color="#E6E6E6" />
                            <SolidColorBrush x:Key="ButtonBorderBrush" Color="#C8C8C8" />
                            <SolidColorBrush x:Key="ButtonBorderBrushPointerOver" Color="#BDBDBD" />
                            <SolidColorBrush x:Key="ButtonBorderBrushPressed" Color="#BDBDBD" />
                            <SolidColorBrush x:Key="ButtonForeground" Color="#1B1B1B" />
                            <SolidColorBrush x:Key="ButtonForegroundPointerOver" Color="#1B1B1B" />
                            <SolidColorBrush x:Key="ButtonForegroundPressed" Color="#5C5C5C" />
                        </ResourceDictionary>
                        <ResourceDictionary x:Key="Default">
                            <SolidColorBrush x:Key="ButtonBackground" Color="#2B2B2B" />
                            <SolidColorBrush x:Key="ButtonBackgroundPointerOver" Color="#363636" />
                            <SolidColorBrush x:Key="ButtonBackgroundPressed" Color="#262626" />
                            <SolidColorBrush x:Key="ButtonBorderBrush" Color="#444444" />
                            <SolidColorBrush x:Key="ButtonBorderBrushPointerOver" Color="#4E4E4E" />
                            <SolidColorBrush x:Key="ButtonBorderBrushPressed" Color="#444444" />
                            <SolidColorBrush x:Key="ButtonForeground" Color="#FFFFFF" />
                            <SolidColorBrush x:Key="ButtonForegroundPointerOver" Color="#FFFFFF" />
                            <SolidColorBrush x:Key="ButtonForegroundPressed" Color="#C5C5C5" />
                        </ResourceDictionary>
                    </ResourceDictionary.ThemeDictionaries>
                </ResourceDictionary>
            </Button.Resources>

            <Button.ContextFlyout>
                <MenuFlyout>
                    <ToggleMenuFlyoutItem x:Name="AlwaysOnTopItem" Click="AlwaysOnTopItem_Click">
                        <ToggleMenuFlyoutItem.Icon>
                            <FontIcon Glyph="&#xE718;" />
                        </ToggleMenuFlyoutItem.Icon>
                    </ToggleMenuFlyoutItem>
                    <ToggleMenuFlyoutItem x:Name="StartWithWindowsItem" Click="StartWithWindowsItem_Click" />
                    <MenuFlyoutSeparator />
                    <MenuFlyoutItem x:Name="ExitItem" Click="ExitItem_Click">
                        <MenuFlyoutItem.Icon>
                            <FontIcon Glyph="&#xE7E8;" />
                        </MenuFlyoutItem.Icon>
                    </MenuFlyoutItem>
                </MenuFlyout>
            </Button.ContextFlyout>

            <FontIcon
                x:Name="ThemeIcon"
                FontSize="16"
                Glyph="&#xE706;"
                RenderTransformOrigin="0.5,0.5">
                <FontIcon.RenderTransform>
                    <RotateTransform x:Name="IconRotation" />
                </FontIcon.RenderTransform>
            </FontIcon>
        </Button>
    </Grid>
</Window>
